// =========================================================================
// POWER BI DAX MEASURES: EVENT PHOTO SAAS FEASIBILITY STUDY
// Fully Aligned with 'Feasibility_Study_DataModel_Master.xlsx'
// Scope: Indonesia Domestic Market (IDR Currency Standard)
// =========================================================================

// =========================================================================
// GRUP 1: UNIT ECONOMICS & PROFITABILITAS (Tabel: Fact_UnitEconomics_BEP)
// =========================================================================

// 1. Rata-rata Harga Paket (Baseline Target: Rp 299.000)
Avg Retail Price IDR = 
AVERAGE('Fact_UnitEconomics_BEP'[package_price_idr])

// 2. Rata-rata Biaya Cloud per Event (AWS S3 + Egress: ~Rp 17.400)
Avg Cloud Cost IDR = 
AVERAGE('Fact_UnitEconomics_BEP'[cloud_cost_idr])

// 3. Rata-rata Biaya Payment Gateway per Event (Midtrans Blended: ~Rp 6.700)
Avg PG Fee IDR = 
AVERAGE('Fact_UnitEconomics_BEP'[pg_fee_idr])

// 4. Rata-rata Customer Acquisition Cost (CAC)
Avg CAC IDR = 
AVERAGE('Fact_UnitEconomics_BEP'[cac_idr])

// 5. Gross Margin per Event (IDR)
Unit Gross Margin IDR = 
AVERAGE('Fact_UnitEconomics_BEP'[gross_margin_idr])

// 6. Gross Margin Percentage (%)
Gross Margin Pct = 
DIVIDE(
    [Unit Gross Margin IDR],
    [Avg Retail Price IDR],
    0
)

// 7. Unit Contribution Margin (IDR)
Unit Contribution Margin IDR = 
AVERAGE('Fact_UnitEconomics_BEP'[contribution_margin_idr])

// 8. Contribution Margin Percentage (%)
Contribution Margin Pct = 
DIVIDE(
    [Unit Contribution Margin IDR],
    [Avg Retail Price IDR],
    0
)

// 9. Target Volume Titik Impas (BEP) Bulanan (Fixed OpEx = Rp 5.000.000 / bln)
BEP Target Volume Events = 
DIVIDE(
    5000000, 
    [Unit Contribution Margin IDR], 
    BLANK()
)

// 10. Status Kelayakan BEP Dinamis
BEP Feasibility Status = 
IF(
    [Unit Contribution Margin IDR] <= 0,
    "❌ Infeasible (Margin Negatif)",
    IF(
        [BEP Target Volume Events] > 50,
        "⚠️ High Risk (BEP Terlalu Tinggi)",
        "✅ Viable (BEP Terjangkau)"
    )
)


// =========================================================================
// GRUP 2: SIMULASI MONTE CARLO (Tabel: Fact_MonteCarlo_Simulations)
// =========================================================================

// 11. B2C 12-Month Win-Rate (% Skenario Kas Positif)
MC Win Rate B2C 12M = 
DIVIDE(
    CALCULATE(COUNTROWS('Fact_MonteCarlo_Simulations'), 'Fact_MonteCarlo_Simulations'[b2c_profitable_m12] = TRUE()),
    COUNTROWS('Fact_MonteCarlo_Simulations'),
    0
)

// 12. B2B 12-Month Win-Rate (% Skenario Kas Positif)
MC Win Rate B2B 12M = 
DIVIDE(
    CALCULATE(COUNTROWS('Fact_MonteCarlo_Simulations'), 'Fact_MonteCarlo_Simulations'[b2b_profitable_m12] = TRUE()),
    COUNTROWS('Fact_MonteCarlo_Simulations'),
    0
)

// 13. B2C 24-Month Win-Rate (Probabilitas Bertahan 2 Tahun)
MC Win Rate B2C 24M = 
DIVIDE(
    CALCULATE(COUNTROWS('Fact_MonteCarlo_Simulations'), 'Fact_MonteCarlo_Simulations'[b2c_profitable_m24] = TRUE()),
    COUNTROWS('Fact_MonteCarlo_Simulations'),
    0
)

// 14. B2B 24-Month Win-Rate (Probabilitas Bertahan 2 Tahun)
MC Win Rate B2B 24M = 
DIVIDE(
    CALCULATE(COUNTROWS('Fact_MonteCarlo_Simulations'), 'Fact_MonteCarlo_Simulations'[b2b_profitable_m24] = TRUE()),
    COUNTROWS('Fact_MonteCarlo_Simulations'),
    0
)

// 15. Median Net Profit B2C (12 Bulan)
MC Median Profit B2C 12M IDR = 
MEDIAN('Fact_MonteCarlo_Simulations'[b2c_profit_m12])

// 16. Median Net Profit B2B (12 Bulan)
MC Median Profit B2B 12M IDR = 
MEDIAN('Fact_MonteCarlo_Simulations'[b2b_profit_m12])

// 17. Median Net Profit B2B (24 Bulan)
MC Median Profit B2B 24M IDR = 
MEDIAN('Fact_MonteCarlo_Simulations'[b2b_profit_m24])

// 18. Value at Risk (VaR 95% Skenario Terburuk B2C 12 Bulan)
MC VaR 95 B2C 12M IDR = 
PERCENTILE.INC('Fact_MonteCarlo_Simulations'[b2c_profit_m12], 0.05)

// 19. Value at Risk (VaR 95% Skenario Terburuk B2B 12 Bulan)
MC VaR 95 B2B 12M IDR = 
PERCENTILE.INC('Fact_MonteCarlo_Simulations'[b2b_profit_m12], 0.05)


// =========================================================================
// GRUP 3: LINTASAN KAS & RUNWAY (Tabel: Fact_Monthly_Cashflow_Paths)
// =========================================================================

// 20. Rata-rata Saldo Kas B2C per Bulan
Avg Monthly Cash Balance B2C IDR = 
AVERAGE('Fact_Monthly_Cashflow_Paths'[cash_b2c])

// 21. Rata-rata Saldo Kas B2B per Bulan
Avg Monthly Cash Balance B2B IDR = 
AVERAGE('Fact_Monthly_Cashflow_Paths'[cash_b2b])

// 22. Rata-rata Akumulasi Mitra WO Aktif (B2B)
Avg Active WO Partners = 
AVERAGE('Fact_Monthly_Cashflow_Paths'[wo_partners])
